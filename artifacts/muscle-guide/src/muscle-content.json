 499 447 504 455C509 463 509 470 512 470C515 470 516 463 521 455C526 447 536 436 545 420C554 404 580 360 575 356C570 352 533 398 512 398C491 398 455 352 450 356Z"]]},"muscles":{"chest":{"n":"الصدر","ex":"ضغط الصدر على الجهاز","m":"Lever Chest Press","mk":"lever","a":"press","s":["اضبط المقعد بحيث تكون المقابض في مستوى منتصف الصدر.","ثبّت الظهر والكتفين على المسند وامسك المقبض بقبضة مريحة.","ادفع الذراعين للأمام حتى تقترب من فرد الكوع دون قفله بالكامل.","ارجع ببطء حتى تشعر بالتمدد في الصدر."],"t":"لا ترفع الكتفين ولا تقوس أسفل الظهر، واجعل النزول أبطأ من الصعود.","alt":"بديل: ضغط دمبل على بنش مائل."},"shoulders":{"n":"الكتف","ex":"رفرفة جانبية","m":"دمبل خفيف","mk":"dumb","a":"raise","s":["قف منتصباً والدمبل في كل يد بجانب الجسم.","ارفع الذراعين جانباً حتى يصلا تقريباً لمستوى الكتف.","حافظ على ثني الكوع قليلاً وثباته طوال الحركة.","أنزل ببطء دون أن تتأرجح بالجسم."],"t":"الوزن الخفيف مع حركة نظيفة أفضل من وزن ثقيل يرمي الجسم. ارفع حتى مستوى الكتف فقط.","alt":"بديل: رفرفة على الكيبل من جانب واحد."},"biceps":{"n":"البايسبس","ex":"ثني الذراع على الكيبل (يد واحدة)","m":"Cable Unilateral Bicep Curl","mk":"cable","a":"curl","s":["قف بجانب الكيبل وامسك المقبض بيد واحدة مع ملاصقة الكوع للجسم.","ارفع الساعد نحو الكتف بثبات حتى ينقبض البايسبس.","توقف لحظة في الأعلى ثم أرجع ببطء.","كرر بنفس الجانب قبل التبديل."],"t":"لا تهز الجسم للخلف لرفع الوزن. الكوع هو محور الحركة ويبقى قريباً من الجسم.","alt":"بديل: ثني الدمبل بالتبادل على المقعد."},"triceps":{"n":"الترايسبس","ex":"شد الكيبل للأسفل","m":"جهاز الكيبل مع مقبض مستقيم","mk":"cable","a":"down","s":["قف مواجهاً للكيبل والمقبض في مستوى الصدر تقريباً.","ثبّت الكوعين بجانب الجسم.","ادفع المقبض للأسفل حتى تفرد الذراعين بالكامل.","ارجع ببطء حتى يصل الكوع إلى زاوية 90 درجة تقريباً."],"t":"الكوعان ثابتان ولا يتحركان للأمام. إذا احتجت للتأرجح فالوزن أثقل من اللازم.","alt":"بديل: تمديد الترايسبس فوق الرأس بالدمبل."},"forearms":{"n":"الساعد","ex":"ثني المعصم بالدمبل","m":"دمبل خفيف","mk":"dumb","a":"curl","s":["اجلس واضعاً الساعد على الفخذ مع بروز المعصم خارج الركبة.","امسك الدمبل بقبضة لأسفل ثم ارفع المعصم للأعلى.","توقف لحظة ثم أنزل ببطء.","الساعد يبقى ثابتاً والحركة من المعصم فقط."],"t":"استخدم وزناً خفيفاً جداً، فالساعد يتعب بسرعة وقد يحدث إجهاد في المعصم.","alt":"بديل: حمل الدمبل بقبضة قوية لمدة قصيرة."},"back":{"n":"الظهر العريض","ex":"سحب الكيبل المنخفض","m":"Lever Low Row","mk":"lever","a":"row","s":["اجلس بصدر مرفوع وقدمين على المسند وركبتين مثنيتين قليلاً.","امسك المقبض وابدأ بظهر مستقيم.","اسحب المقبض نحو أسفل الصدر وقرّب لوحي الكتف للخلف.","ارجع ببطء مع الحفاظ على تمدد الظهر دون تقريب الكتفين للأمام."],"t":"لا تستخدم الظهر لهز الوزن للخلف. الهدف هو الظهر، فحافظ على الكتف بعيداً عن الأذن.","alt":"بديل: سحب الكيبل العلوي (Lat Pulldown)."},"lower_back":{"n":"أسفل الظهر","ex":"تمديد أسفل الظهر","m":"جهاز تمديد الظهر","mk":"bench","a":"crunch","s":["ثبّت الوسط على المسند والقدمين تحت الوسادات.","انزل بالجذع للأمام بتحكم حتى تشعر بتمدد الظهر.","ارفع الجذع حتى يصبح الجسم في خط مستقيم دون إفراط في تقويس الظهر.","لا ترفع أعلى من خط الجسم."],"t":"الحركة تأتي من الورك وليس من أسفل الظهر. تجنب الارتداد السريع.","alt":"بديل: رفعة الديدلفت الروماني بوزن خفيف."},"abs":{"n":"البطن","ex":"تكسير البطن على الكيبل","m":"Cable Crunch","mk":"cable","a":"crunch","s":["اركع أمام الكيبل وامسك الحبل بجانب الرأس.","ابدأ بشد البطن وسحب الجذع للأسفل نحو الركبتين.","توقف لحظة وانقبض البطن بقوة.","ارجع ببطء دون أن تسحب الوزن بالذراعين."],"t":"الحركة تأتي من البطن وليس من الذراعين أو الكتفين.","alt":"بديل: تكسير البطن على الأرض."},"quads":{"n":"الفخذ الأمامي","ex":"القرفصاء على جهاز Hack Squat","m":"Sled Closer Hack Squat","mk":"hack","a":"squat","s":["ضع ظهرك على المسند وقدميك بعرض الكتفين على المنصة.","فك الأمان وانزل ببطء حتى تقترب الفخذ من التوازي مع الأرض أو أعمق بقدر راحتك.","ادفع بكعب القدم للصعود حتى تفرد الركبتين دون قفلهما بعنف.","حافظ على اتجاه الركبتين نحو أصابع القدم."],"t":"نزول أعمق بتحكم أفضل من وزن كبير بنصف مدى حركة. لا تقفل الركبة بعنف في الأعلى.","alt":"بديل: القرفصاء بالوزن الحر (Full Squat)."},"hamstrings":{"n":"الفخذ الخلفي","ex":"ثني الركبة على جهاز الفخذ الخلفي","m":"Leg Curl","mk":"bench","a":"legcurl","s":["اضبط الوسادة فوق الكاحل مباشرة.","امسك المقابض وثبّت الوسط على المقعد.","اثنِ الركبتين واسحب الوسادة نحو المؤخرة.","ارجع ببطء حتى تفرد الساق دون قفلها بالكامل."],"t":"لا ترفع الوسط عن المقعد لتساعد الحركة. التحكم في النزول مهم.","alt":"بديل: Romanian Deadlift بالدمبل."},"glutes":{"n":"المؤخرة","ex":"دفع الورك (Hip Thrust)","m":"جهاز Hip Thrust أو بنش مع وسادة","mk":"bench","a":"thrust","s":["اجلس وظهر الكتفين مستند على البنش وقدماك على الأرض.","ضع الوزن على الحوض بوسادة مريحة.","ادفع الورك للأعلى حتى يصبح الجسم خطاً مستقيماً من الكتف للركبة.","اضغط المؤخرة لحظة في الأعلى ثم أنزل ببطء."],"t":"لا تقوس أسفل الظهر في الأعلى. المحرك هو المؤخرة وليس أسفل الظهر.","alt":"بديل: Glute Kickback على الكيبل."},"calves":{"n":"السمانة","ex":"رفع السمانة على الجهاز","m":"Standing Calf Raise","mk":"calf","a":"calf","s":["ضع الكتفين تحت الوسادات والكعبين على حافة المنصة.","ارفع الكعبين لأعلى قدر تستطيع مع الضغط على أصابع القدم.","توقف لحظة في الأعلى.","أنزل الكعبين ببطء حتى تشعر بالتمدد الكامل."],"t":"الحركة كلها في الكاحل. النزول البطيء والتمدد الكامل يعطيان نتيجة أفضل.","alt":"بديل: رفع السمانة بالدمبل على الدرج."},"traps":{"n":"الترابيس","ex":"رفع الكتفين بالدمبل (Shrug)","m":"دمبل","mk":"dumb","a":"shrug","s":["قف منتصباً والدمبل في كل يد بجانب الجسم والذراعان مفرودتان.","ارفع الكتفين نحو الأذنين بحركة رأسية مباشرة.","توقف لحظة في الأعلى وانقبض الترابيس.","أنزل ببطء حتى تتمدد العضلة دون تدوير الكتفين."],"t":"لا تدوّر الكتفين ولا تثنِ الكوعين. الحركة لأعلى وأسفل فقط.","alt":"بديل: رفع الكتفين على جهاز سميث."},"obliques":{"n":"الجانبية","ex":"الانحناء الجانبي بالدمبل","m":"دمبل واحد","mk":"dumb","a":"sidebend","s":["قف ودمبل في يد واحدة والذراع الأخرى خلف الرأس.","انحنِ جانباً نحو جهة الدمبل بتحكم.","ارفع الجذع للأعلى بقوة العضلة الجانبية لا بالذراع.","أكمل العدد ثم بدّل الجانب."],"t":"لا تلفّ الجذع للأمام أو الخلف، ولا تستخدم وزناً ثقيلاً يضغط على أسفل الظهر.","alt":"بديل: الجانبية على الأرض (Side Plank)."},"adductors":{"n":"الفخذ الداخلي","ex":"تقريب الفخذين على الجهاز","m":"Adductor Machine","mk":"bench","a":"adduct","s":["اجلس والظهر ملاصق للمسند واضبط الوسادات على الجانب الداخلي للركبتين.","ابدأ بالساقين مفتوحتين في مدى مريح.","قرّب الساقين نحو بعضهما بحركة ثابتة.","ارجع ببطء ولا تدع الوزن يسحب ساقيك."],"t":"لا تفتح الساقين أكثر من مدى مريح، فالتمدد الزائد يجهد الفخذ الداخلي.","alt":"بديل: قرفصاء سومو بالدمبل."},"rear_delts":{"n":"الكتف الخلفي","ex":"رفرفة خلفية على الجهاز","m":"Reverse Pec Deck","mk":"lever","a":"rear","s":["اجلس مواجهاً للمسند وصدرك عليه واضبط المقابض في مستوى الكتفين.","امسك المقابض والكوعان مثنيان قليلاً.","افتح الذراعين للخلف وقرّب لوحي الكتف قليلاً.","ارجع ببطء دون أن تترك الوزن يرتطم."],"t":"ارفع بالكتف لا بالظهر، والوزن الخفيف أفضل هنا.","alt":"بديل: رفرفة خلفية بالدمبل وأنت منحنٍ."},"tibialis":{"n":"مقدمة الساق","ex":"رفع مقدمة القدم","m":"بدون جهاز أو Tibialis Raise","mk":"bench","a":"tib","s":["قف مسنداً ظهرك للحائط وقدماك أمام الجسم قليلاً.","ارفع أصابع القدم نحو الساق مع بقاء الكعبين على الأرض.","توقف لحظة في الأعلى.","أنزل ببطء دون ارتطام."],"t":"ابدأ بدون وزن، فمقدمة الساق عضلة صغيرة تتعب بسرعة.","alt":"بديل: المشي على الكعبين لمسافة قصيرة."},"neck":{"n":"الرقبة","ex":"ثني الرقبة جانباً بمقاومة اليد","m":"بدون جهاز","mk":"bench","a":"neck","s":["اجلس أو قف بظهر مستقيم وكتفين مرتخيين.","ضع كف يدك على جانب الرأس فوق الأذن.","ادفع الرأس نحو اليد بقوة خفيفة وثبّت لثوانٍ دون حركة.","أرخِ ببطء ثم كرر على الجهة الأخرى."],"t":"استخدم مقاومة خفيفة جداً ولا تلوِ الرقبة بسرعة ولا ترجّعها للخلف بقوة. توقف فوراً عند أي ألم أو تنميل.","alt":"بديل: ثني الرقبة للأمام والخلف بمقاومة اليد بنفس الطريقة."},"mid_back":{"n":"الظهر الأوسط","ex":"السحب الأفقي بالكيبل","m":"Seated Cable Row","mk":"cable","a":"row","s":["اجلس والقدمان على المسند والركبتان مثنيتان قليلاً وامسك المقبض.","ابدأ بظهر مستقيم وصدر مرفوع.","اسحب المقبض نحو أسفل الصدر وقرّب لوحي الكتف من بعضهما.","ارجع ببطء مع تمدد الذراعين دون انحناء الظهر."],"t":"لا تتأرجح بالجذع للخلف، وأبقِ الكتفين بعيدين عن الأذنين. الحركة من لوحي الكتف.","alt":"بديل: سحب الدمبل بذراع واحدة على البنش."}}}